# forecast-vintage-epf environment variables
#
# Copy this file to `.env` and edit the values. The harness reads
# everything via `alg.config.EpfConfig` (pydantic-settings), so any
# variable can also be set in the shell instead.
#
# Path defaults resolve relative to the repository root (the
# directory containing pyproject.toml + alg/).

# --- Data directories ---------------------------------------------
# Raw downloads (JEPX CSVs, JMA MSM-GPV grids, Open-Meteo JSON, OCCTO, ICS).
# Not redistributed; see data/README.md for acquisition.
EPF_RAW_DATA_DIR=data/raw

# Derived parquets / intermediate tables (loader-script output).
EPF_PROCESSED_DATA_DIR=data/processed

# Per-fold run artefacts (scripts/* write here).
EPF_RUN_DIR=data/runs

# Frozen provenance shipped with this repository. The drift guard reads
# whichever of EPF_RUN_DIR / data/provenance actually holds the JSONs, so a
# clean clone verifies the paper without ever populating data/runs.

# --- Default area for headline runs -------------------------------
# Paper headlines are the Kyushu cell; cross-area sweeps iterate.
EPF_DEFAULT_AREA=kyushu

# --- Timezone ----------------------------------------------------
EPF_TZ=Asia/Tokyo

# --- MLflow / W&B (optional) -------------------------------------
# Logged values are NOT load-bearing for any paper headline number;
# leave these disabled for a clean reproduction.
EPF_MLFLOW_TRACKING_URI=file:./data/mlruns
EPF_WANDB_MODE=disabled
# EPF_WANDB_PROJECT=
# EPF_WANDB_ENTITY=
